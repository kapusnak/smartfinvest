# Canonická URL (metadata, sitemap, robots). Může být i jen host (bez https://) — doplní se automaticky.
NEXT_PUBLIC_SITE_URL=https://smartfinvest.cz

# SMTP (Spacemail) — jen na serveru (Railway Variables). Nikdy NEXT_PUBLIC_*.
# Host: mail.spacemail.com | Port: 465 (SSL) nebo 587 (STARTTLS)
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=info@smartfinvest.cz
SMTP_PASS=
# Příjemce notifikací o nových poptávkách
LEAD_NOTIFY_TO=info@smartfinvest.cz
# Volitelně: From hlavička. Bez ní: "smartfinvest.cz" <SMTP_USER>
# MAIL_FROM="smartfinvest.cz <info@smartfinvest.cz>"

# Analytics (volitelné)
# NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RMX82F6JBH
# NEXT_PUBLIC_GOOGLE_ADS_AW_ID=
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_SEND_TO=
