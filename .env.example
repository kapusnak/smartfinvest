# Canonická URL (metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://smartfinvest.cz

# EmailJS — musí být nastavené před `npm run build` u statického exportu
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# Volitelné: klientské potvrzení e-mailem (pokud má šablonu v EmailJS)
# NEXT_PUBLIC_EMAILJS_CLIENT_TEMPLATE_ID=template_xxx

# Volitelné: Google Ads konverze (gtag) — stejně jako docasnyvykup
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_SEND_TO=
